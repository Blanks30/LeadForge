# ==============================================================================
# LeadForge Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# DO NOT commit real API keys or credentials to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Offline Mock Mode (default: true for development/evaluation without external APIs)
# Set to false only when valid external API keys are configured below
USE_MOCK_APIS=true

# External API Keys (Leave blank when USE_MOCK_APIS=true)
TINYFISH_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Async SQLite with aiosqlite)
# Points to persistent SQLite file on disk. For Docker/container deployment,
# mount a persistent host volume to the directory containing this file.
DATABASE_URL=sqlite+aiosqlite:///backend/data/leadforge.db

# Frontend Cross-Origin Resource Sharing (CORS)
# Allowed origins as JSON array of URL strings (e.g., ["http://localhost:5173", "https://yourdomain.com"])
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
